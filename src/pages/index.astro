---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ravenBranch from "@/assets/raven-branch-empty.png";
import perchedRaven from "@/assets/raven-perched.png";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getProjects } from "@/data/projects";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts, locale);
const projects = getProjects(locale);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout description={locale === "zh" ? t.home.description : undefined}>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="branch-wrap" aria-hidden="true">
        <Image
          src={ravenBranch}
          alt=""
          width={620}
          widths={[360, 620, 1240]}
          sizes="(max-width: 652px) calc(100vw - 32px), 620px"
          loading="eager"
          class="branch"
        />
        <Image
          src={perchedRaven}
          alt=""
          width={150}
          densities={[1, 2]}
          loading="eager"
          class="perched-raven"
        />
      </div>
      {
        t.home.greeting.trim() && (
          <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
            {t.home.greeting}
          </h1>
        )
      }

      <p>
        {t.home.description}
      </p>
      <p class="mt-2"></p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section
      id="projects"
      class:list={[
        "pt-12 pb-6",
        { "border-border border-b": sortedPosts.length > 0 },
      ]}
    >
      <h2 class="text-2xl font-semibold tracking-wide">
        {t.home.projects}
      </h2>
      <p class="text-muted-foreground mt-2 text-sm">
        {t.home.projectsDescription}
      </p>
      <ul class="mt-3">
        {projects.map(project => <ProjectCard {...project} />)}
      </ul>
    </section>

    {
      sortedPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {sortedPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .branch-wrap {
    position: relative;
    width: min(100%, 620px);
    margin: 0 auto 2rem;
  }

  .branch {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Anchor the feet to the middle-right branch; blending removes the source image's white canvas. */
  .perched-raven {
    position: absolute;
    width: 24.2%;
    height: auto;
    left: 59%;
    top: 1.5%;
    mix-blend-mode: multiply;
  }

  :global([data-theme="dark"]) .branch,
  :global([data-theme="dark"]) .perched-raven {
    filter: invert(1);
  }

  :global([data-theme="dark"]) .perched-raven {
    mix-blend-mode: screen;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem(
        `backUrl:${document.documentElement.lang}`,
        indexLayout.homePath ?? baseRoot
      );
    }
  });
</script>
